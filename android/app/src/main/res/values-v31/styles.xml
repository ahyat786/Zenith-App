<resources>

    <!--
      Android 12+ (API 31) memakai SplashScreen API: ikon aplikasi + latar
      bertema ditampilkan sebelum React siap, lalu memudar ke konten.
      Nilai di sini harus mengulang seluruh isi AppTheme karena kualifikasi
      resource menggantikan definisi style, bukan menggabungkannya.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/zenith_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>

        <item name="android:windowSplashScreenBackground">@color/zenith_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/zenith_splash_icon_background</item>
    </style>

</resources>
